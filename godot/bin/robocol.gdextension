[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/librobocol_godot.debug.so"
linux.release.x86_64 = "res://bin/librobocol_godot.so"
macos.debug = "res://bin/librobocol_godot.debug.dylib"
macos.release = "res://bin/librobocol_godot.dylib"
windows.debug.x86_64 = "res://bin/robocol_godot.debug.dll"
windows.release.x86_64 = "res://bin/robocol_godot.dll"

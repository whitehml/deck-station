; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deck Driver Station"
config/version="dev"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

MockHarness="*res://autoloads/mock_harness.gd"
GamepadBridge="*res://autoloads/gamepad_bridge.gd"
GripInput="*res://autoloads/grip_input.gd"
RobotClient="*res://autoloads/robot_client.gd"
TelemetryLog="*res://autoloads/telemetry_log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

